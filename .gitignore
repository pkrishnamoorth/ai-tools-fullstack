# Mastery .gitignore for Ultimate StudentHub

# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
**/.env

# Build outputs
/studenthub/client/dist
/studenthub/client/build
**/dist/*
**/build/*

# OS Files
.DS_Store
Thumbs.db

# IDE Files
.vscode/
.idea/
*.swp

# Application specific
/studenthub/server/uploads/*
!/studenthub/server/uploads/.gitkeep
